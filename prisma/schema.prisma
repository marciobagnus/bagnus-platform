generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id String @id @db.Uuid

  name     String
  lastName String?
  dni      String? @unique
  phone    String  @unique
  email    String?
  address  String?

  createdAt DateTime
  updatedAt DateTime

  machines Machine[]

  @@map("customers")
}

model Machine {
  id         String @id @db.Uuid
  customerId String @db.Uuid

  brand        String
  type         String
  model        String?
  serialNumber String?

  createdAt DateTime
  updatedAt DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  repairOrders RepairOrder[]

  @@index([customerId])
  @@map("machines")
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  IN_REPAIR
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  AWAITING_PICKUP_UNREPAIRED
}

model RepairOrder {
  id        String @id @db.Uuid
  machineId String @db.Uuid

  reportedIssue       String
  receivedAccessories String?

  status RepairStatus @default(RECEIVED)

  receivedAt DateTime
  createdAt  DateTime
  updatedAt  DateTime

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  statusHistory RepairStatusHistory[]

  quotes RepairQuote[]

  payments Payment[]

  diagnosisCharge DiagnosisCharge?

  @@index([machineId])
  @@index([status])
  @@map("repair_orders")
}

model RepairStatusHistory {
  id            String @id @db.Uuid
  repairOrderId String @db.Uuid

  fromStatus RepairStatus?
  toStatus   RepairStatus

  note      String?
  changedAt DateTime

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)

  @@index([repairOrderId, changedAt])
  @@map("repair_status_history")
}

enum QuoteStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuoteDecisionChannel {
  IN_PERSON
  PHONE
  WHATSAPP
  EMAIL
  CUSTOMER_PORTAL
}

model RepairQuote {
  id            String @id @db.Uuid
  repairOrderId String @db.Uuid

  version Int

  description String
  totalAmount Decimal @db.Decimal(12, 2)
  currency    String  @default("ARS")

  status QuoteStatus @default(DRAFT)

  createdAt DateTime
  updatedAt DateTime

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)

  decisions QuoteDecision[]

  @@unique([repairOrderId, version])
  @@index([repairOrderId])
  @@map("repair_quotes")
}

model QuoteDecision {
  id      String @id @db.Uuid
  quoteId String @db.Uuid

  approved Boolean
  channel  QuoteDecisionChannel

  note      String?
  decidedAt DateTime

  quote RepairQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([quoteId])
  @@index([quoteId])
  @@map("quote_decisions")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model Payment {
  id            String @id @db.Uuid
  repairOrderId String @db.Uuid

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("ARS")
  method   PaymentMethod

  reference String?
  note      String?

  receivedAt DateTime
  createdAt  DateTime

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)

  @@index([repairOrderId, receivedAt])
  @@map("payments")
}

enum DiagnosisDecision {
  CHARGED
  WAIVED
}

model DiagnosisCharge {
  id            String @id @db.Uuid
  repairOrderId String @unique @db.Uuid

  decision DiagnosisDecision
  amount   Decimal           @db.Decimal(12, 2)
  currency String            @default("ARS")

  note      String?
  decidedAt DateTime

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)

  @@map("diagnosis_charges")
}
