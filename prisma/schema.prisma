generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id String @id @db.Uuid

  name     String
  lastName String?
  dni      String? @unique
  phone    String  @unique
  email    String?
  address  String?

  createdAt DateTime
  updatedAt DateTime

  machines Machine[]

  @@map("customers")
}

model Machine {
  id         String @id @db.Uuid
  customerId String @db.Uuid

  brand        String
  type         String
  model        String?
  serialNumber String?

  createdAt DateTime
  updatedAt DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  repairOrders RepairOrder[]

  @@index([customerId])
  @@map("machines")
}

enum RepairStatus {
  RECEIVED
  WAITING_APPROVAL
  IN_REPAIR
  READY_FOR_PICKUP
  DELIVERED
}

// Legacy values are read-only history; never operational states.
enum RepairHistoryStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  IN_REPAIR
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  AWAITING_PICKUP_UNREPAIRED
}

model RepairOrder {
  id        String @id @db.Uuid
  machineId String @db.Uuid

  reportedIssue       String
  receivedAccessories String?

  status RepairStatus @default(RECEIVED)
  resolution RepairResolution?
  deliveredAt DateTime?

  receivedAt DateTime
  createdAt  DateTime
  updatedAt  DateTime

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  statusHistory RepairStatusHistory[]

  quotes RepairQuote[]

  payments Payment[]

  diagnosisCharge DiagnosisCharge?

  @@index([machineId])
  @@index([status])
  @@map("repair_orders")
}

enum RepairResolution {
  REPAIRED
  QUOTE_REJECTED
}

model RepairStatusHistory {
  id              String  @id @db.Uuid
  repairOrderId   String  @db.Uuid
  changedByUserId String? @db.Uuid

  fromStatus RepairHistoryStatus?
  toStatus   RepairHistoryStatus

  note      String?
  changedAt DateTime

  repairOrder RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)
  changedBy   InternalUser? @relation("RepairStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([repairOrderId, changedAt])
  @@index([changedByUserId])
  @@map("repair_status_history")
}

enum QuoteStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuoteDecisionChannel {
  IN_PERSON
  PHONE
  WHATSAPP
  EMAIL
  CUSTOMER_PORTAL
}

model RepairQuote {
  id            String @id @db.Uuid
  repairOrderId String @db.Uuid

  version Int

  description String
  totalAmount Decimal @db.Decimal(12, 2)
  currency    String  @default("ARS")

  status QuoteStatus @default(DRAFT)

  createdAt DateTime
  updatedAt DateTime

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)

  decisions QuoteDecision[]

  @@unique([repairOrderId, version])
  @@index([repairOrderId])
  @@map("repair_quotes")
}

model QuoteDecision {
  id      String @id @db.Uuid
  quoteId String @db.Uuid
  recordedByUserId String? @db.Uuid

  approved Boolean
  channel  QuoteDecisionChannel

  note      String?
  decidedAt DateTime

  quote RepairQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  recordedBy InternalUser? @relation("QuoteDecisionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([quoteId])
  @@index([quoteId])
  @@index([recordedByUserId])
  @@map("quote_decisions")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model Payment {
  id               String  @id @db.Uuid
  repairOrderId    String  @db.Uuid
  recordedByUserId String? @db.Uuid

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("ARS")
  method   PaymentMethod

  reference String?
  note      String?

  receivedAt DateTime
  createdAt  DateTime

  repairOrder RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)
  recordedBy  InternalUser? @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([repairOrderId, receivedAt])
  @@index([recordedByUserId])
  @@map("payments")
}

enum DiagnosisDecision {
  CHARGED
  WAIVED
}

model DiagnosisCharge {
  id              String  @id @db.Uuid
  repairOrderId   String  @unique @db.Uuid
  decidedByUserId String? @db.Uuid

  decision DiagnosisDecision
  amount   Decimal           @db.Decimal(12, 2)
  currency String            @default("ARS")

  note      String?
  decidedAt DateTime

  repairOrder RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)
  decidedBy   InternalUser? @relation("DiagnosisDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([decidedByUserId])
  @@map("diagnosis_charges")
}

enum InternalUserRole {
  ADMIN
  STAFF
}

model InternalUser {
  id           String           @id @db.Uuid
  username     String           @unique
  displayName  String
  passwordHash String
  role         InternalUserRole
  active       Boolean          @default(true)
  createdAt    DateTime
  updatedAt    DateTime

  sessions InternalSession[]
  loginAttemptBuckets InternalLoginAttemptBucket[]

  passwordResetAuditsPerformed InternalPasswordResetAudit[] @relation("PasswordResetPerformedBy")
  passwordResetAuditsReceived  InternalPasswordResetAudit[] @relation("PasswordResetTarget")
  userCreationAuditsPerformed  InternalUserCreationAudit[] @relation("UserCreationPerformedBy")
  userCreationAuditReceived    InternalUserCreationAudit?  @relation("UserCreationTarget")

  recordedPayments   Payment[]             @relation("PaymentRecordedBy")
  diagnosisDecisions DiagnosisCharge[]     @relation("DiagnosisDecidedBy")
  statusChanges      RepairStatusHistory[] @relation("RepairStatusChangedBy")
  quoteDecisions QuoteDecision[] @relation("QuoteDecisionRecordedBy")

  @@map("internal_users")
}

model InternalPasswordResetAudit {
  id                String   @id @db.Uuid
  performedByUserId String   @db.Uuid
  targetUserId      String   @db.Uuid
  targetUsername    String
  performedAt       DateTime

  performedBy InternalUser @relation("PasswordResetPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  target      InternalUser @relation("PasswordResetTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([performedByUserId, performedAt])
  @@index([targetUserId, performedAt])
  @@map("internal_password_reset_audits")
}

model InternalUserCreationAudit {
  id                String   @id @db.Uuid
  performedByUserId String   @db.Uuid
  createdUserId     String   @unique @db.Uuid
  createdUsername   String
  createdAt         DateTime

  performedBy InternalUser @relation("UserCreationPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  createdUser InternalUser @relation("UserCreationTarget", fields: [createdUserId], references: [id], onDelete: Restrict)

  @@index([performedByUserId, createdAt])
  @@map("internal_user_creation_audits")
}

model InternalSession {
  id        String @id @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique @db.VarChar(64)

  createdAt DateTime
  expiresAt DateTime

  user InternalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("internal_sessions")
}

model InternalLoginAttemptBucket {
  id              String    @id @db.Uuid
  keyHash         String    @unique @db.VarChar(64)
  failedAttempts  Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime

  user InternalUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @db.Uuid

  @@index([updatedAt])
  @@index([userId])
  @@map("internal_login_attempt_buckets")
}
