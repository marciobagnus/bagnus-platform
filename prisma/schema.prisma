generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id String @id @db.Uuid

  name     String
  lastName String?
  dni      String? @unique
  phone    String  @unique
  email    String?
  address  String?

  createdAt DateTime
  updatedAt DateTime

  @@map("customers")
}
